ASI1_API_KEY=
# false = offline fallback only, e.g. for demo replays (saves ASI1 quota)
ASI1_ENABLED=true
# Text sent with each card: short (one line; ASI:One draws the card) or full (whole card as text too,
# for chat clients that don't show cards)
CARD_TEXT=short
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
# Throwaway Postgres for pytest; each test creates and drops its own schema
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
FET_USE_TESTNET=true
DEMO_INR_PER_FET=10000
ARTH_FEE_PCT=1

# One unique seed per agent; never commit
SEED_ORCHESTRATOR=
SEED_LEDGER=
SEED_INVENTORY=
SEED_BILLING=
SEED_COLLECTIONS=
SEED_PROCUREMENT=
SEED_INSIGHTS=
SEED_SUPPLIER_SHREE=
SEED_SUPPLIER_GUPTA=
SEED_SUPPLIER_BALAJI=

# Invoice PDFs: uploaded to Cloudinary so ASI:One gets a (signed) download link.
# Without it PDFs are only saved in invoices/ on this machine.
CLOUDINARY_URL=

# P2 WhatsApp bridge
SARVAM_API_KEY=
TWILIO_SID=
TWILIO_TOKEN=

# New ASI:One users get a private copy of the demo shop (false = an empty shop)
DEMO_COPY_FOR_NEW_USERS=true
