ASI1_API_KEY=
# false = offline fallback only, e.g. for demo replays (saves ASI1 quota)
ASI1_ENABLED=true
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
# Throwaway Postgres for pytest; each test creates and drops its own schema
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
FET_USE_TESTNET=true
DEMO_INR_PER_FET=10000
ARTH_FEE_PCT=1

# One unique seed per agent; never commit
SEED_ORCHESTRATOR=
SEED_LEDGER=
SEED_INVENTORY=
SEED_BILLING=
SEED_COLLECTIONS=
SEED_PROCUREMENT=
SEED_INSIGHTS=
SEED_SUPPLIER_SHREE=
SEED_SUPPLIER_GUPTA=
SEED_SUPPLIER_BALAJI=

# P1 invoice PDFs
SUPABASE_URL=
